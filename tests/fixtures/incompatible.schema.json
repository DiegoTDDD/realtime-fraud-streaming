{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "transaction",
  "description": "Deliberately incompatible: amount becomes a string. CI checks the registry rejects it.",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "card_id": {
      "type": "string"
    },
    "amount": {
      "type": "string"
    },
    "merchant": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "is_fraud": {
      "type": "boolean"
    },
    "fraud_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "high_amount",
        "card_testing",
        "impossible_travel",
        null
      ]
    }
  },
  "required": [
    "transaction_id",
    "card_id",
    "amount",
    "merchant",
    "category",
    "city",
    "timestamp",
    "is_fraud"
  ]
}
